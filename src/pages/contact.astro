---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import '../styles/global.css';

const contactEmail = 'kindnesta@proton.me';
const params = Astro.url.searchParams;
const sku = params.get('sku') ?? '';
const interest = params.get('interest') ?? 'sales';

const subject =
  interest === 'sample'
    ? sku
      ? `Sample request · ${sku}`
      : 'Sample request'
    : interest === 'quote'
      ? sku
        ? `Quote request · ${sku}`
        : 'Quote request'
      : sku
        ? `Product inquiry · ${sku}`
        : 'KindNesta inquiry';

const defaultMessage =
  interest === 'sample'
    ? `I would like to request a sample${sku ? ` for SKU ${sku}` : ''}.`
    : interest === 'quote'
      ? `I would like a quote${sku ? ` for SKU ${sku}` : ''}. Volume / timeline: `
      : interest === 'supplier'
        ? 'I would like to supply products. I have downloaded the partner template.'
        : '';
---

<BaseLayout
  title="Contact — KindNesta"
  description="Contact KindNesta for B2B quotes, samples, catalogue questions, or supplier partnerships."
>
  <section class="page-hero reveal">
    <div class="container">
      <span class="section__eyebrow">Contact</span>
      <h1>Talk to the KindNesta team</h1>
      <p>
        B2B quotes, samples, Kindness Score questions, or supplier submissions — we typically reply
        within 1–2 business days.
      </p>
    </div>
  </section>

  <section class="section reveal" style="padding-top: 1rem;">
    <div class="container contact-layout">
      <div class="contact-primary">
        <h2 class="contact-primary__title">Prefer email?</h2>
        <p class="contact-primary__lead">Reach us directly:</p>
        <a
          class="btn btn--primary"
          href={`mailto:${contactEmail}?subject=${encodeURIComponent(subject)}`}
        >
          {contactEmail}
        </a>
        <ul class="contact-primary__list">
          <li>B2B quote &amp; sample requests</li>
          <li>Catalogue &amp; programme questions</li>
          <li>Retail &amp; enterprise procurement</li>
          <li>
            <a href={withBase('partners/')}>Supplier collaborations</a>
          </li>
        </ul>
        <p class="contact-primary__hint">Typical response within 1–2 business days.</p>
      </div>

      <form
        class="contact-form"
        action={`mailto:${contactEmail}?subject=${encodeURIComponent(subject)}`}
        method="post"
        enctype="text/plain"
      >
        <h2 class="contact-primary__title">Send an inquiry</h2>
        <p class="contact-primary__lead">
          Opens an email draft with your details (optional helper).
        </p>

        <div class="field">
          <label for="buyer-type">I am</label>
          <select id="buyer-type" name="buyer_type" required>
            <option
              value="retail"
              selected={interest !== 'enterprise' && interest !== 'supplier'}
            >
              Retail buyer
            </option>
            <option value="enterprise" selected={interest === 'enterprise'}>
              Enterprise / procurement
            </option>
            <option value="supplier" selected={interest === 'supplier'}>
              Supplier / manufacturer
            </option>
            <option value="other">Other / distributor</option>
          </select>
        </div>
        <div class="field">
          <label for="interest-type">Request type</label>
          <select id="interest-type" name="interest_type" required>
            <option value="quote" selected={interest === 'quote' || interest === 'sales'}>
              Quote
            </option>
            <option value="sample" selected={interest === 'sample'}>Sample</option>
            <option value="supplier" selected={interest === 'supplier'}>Supplier onboarding</option>
            <option value="other">General question</option>
          </select>
        </div>
        <div class="field">
          <label for="company">Company / outlet name</label>
          <input id="company" name="company" type="text" required autocomplete="organization" />
        </div>
        <div class="field">
          <label for="name">Contact name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="sku">Product / SKU of interest (optional)</label>
          <input id="sku" name="sku" type="text" value={sku} placeholder="e.g. PSP-001" />
        </div>
        <div class="field">
          <label for="volume">Estimated volume / locations</label>
          <input
            id="volume"
            name="volume"
            type="text"
            placeholder="e.g. 3 stores · ~200 units / month"
          />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            required
            placeholder="Timeline, assortment needs, sample request…"
          >{defaultMessage}</textarea>
        </div>
        <button class="btn btn--secondary" type="submit">Open email draft</button>
      </form>
    </div>
  </section>
</BaseLayout>
