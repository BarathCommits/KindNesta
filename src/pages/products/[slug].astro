---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KindnessPanel from '../../components/KindnessPanel.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categoryLabel, displayBrand, ecoTagLabel, publicBullets, publicCopy } from '../../lib/products';
import { productImageSources, withBase } from '../../lib/urls';
import '../../styles/global.css';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product, products },
  }));
}

const { product, products } = Astro.props;
const {
  title,
  brand,
  shortDescription,
  description,
  bulletPoints,
  category,
  subcategory,
  image,
  imageGallery,
  kindnessScore,
  kindnessScoreNotes,
  scoreVerified,
  ecoTags,
  materials,
  dimensions,
  weight,
  variantType,
  variantValue,
  parentId,
  relatedIds,
  inStock,
  productFamily,
  sku,
  packSize,
} = product.data;

const shownBrand = displayBrand(brand);
const shownBullets = publicBullets(bulletPoints);
const shownDescription = publicCopy(description);
const shownLead = publicCopy(shortDescription);

const gallery = (imageGallery?.length ? imageGallery : [image]).map((src) => productImageSources(src));
const mainImage = gallery[0];

const variants = parentId
  ? products
      .filter((p) => p.data.parentId === parentId)
      .sort((a, b) => (a.data.variantValue || '').localeCompare(b.data.variantValue || ''))
  : [];

const related = relatedIds.length
  ? relatedIds
      .map((id) => products.find((p) => p.id === id))
      .filter(Boolean)
      .slice(0, 4)
  : products
      .filter((p) => p.id !== product.id && p.data.category === category)
      .slice(0, 4);

const specs = [
  sku ? { label: 'SKU', value: sku } : null,
  materials ? { label: 'Materials', value: materials } : null,
  dimensions ? { label: 'Dimensions', value: dimensions } : null,
  weight ? { label: 'Weight', value: weight } : null,
  packSize ? { label: 'Case pack', value: packSize } : null,
  subcategory ? { label: 'Browse node', value: subcategory } : null,
  variantType && variantValue ? { label: variantType, value: variantValue } : null,
].filter(Boolean) as { label: string; value: string }[];

const quoteHref = withBase(
  `contact/?sku=${encodeURIComponent(sku)}&interest=quote`
);
const sampleHref = withBase(
  `contact/?sku=${encodeURIComponent(sku)}&interest=sample`
);
---

<BaseLayout title={`${title} — KindNesta`} description={shortDescription}>
  <section class="section amazon-pdp" style="padding-top: 2rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={withBase()}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={withBase("products/")}>Products</a>
        <span aria-hidden="true">/</span>
        <a href={withBase(`products/?category=${category}`)}>{categoryLabel(category)}</a>
        {
          subcategory && (
            <>
              <span aria-hidden="true">/</span>
              <span>{subcategory}</span>
            </>
          )
        }
      </nav>

      <div class="amazon-pdp__grid">
        <div class="amazon-gallery reveal" data-gallery>
          <div class="amazon-gallery__stage">
            <picture>
              <source id="gallery-main-webp" srcset={mainImage.webp} type="image/webp" />
              <img
                id="gallery-main"
                src={mainImage.src}
                alt={title}
                width="900"
                height="900"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
          <p class="amazon-gallery__note">Illustrative image — representative of product type until supplier photography is available.</p>
          {
            gallery.length > 1 && (
              <div class="amazon-gallery__thumbs" role="list">
                {gallery.map((img, i) => (
                  <button
                    type="button"
                    class:list={['amazon-gallery__thumb', i === 0 && 'is-active']}
                    data-gallery-src={img.src}
                    data-gallery-webp={img.webp}
                    aria-label={`View image ${i + 1}`}
                  >
                    <picture>
                      <source srcset={img.webp} type="image/webp" />
                      <img src={img.src} alt="" width="72" height="72" loading="lazy" decoding="async" />
                    </picture>
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <div class="amazon-pdp__info reveal">
          {shownBrand && <p class="amazon-pdp__brand">{shownBrand}</p>}
          <h1 class="amazon-pdp__title">{title}</h1>
          <p class="amazon-pdp__lead">{shownLead}</p>

          <div class="amazon-pdp__score-row">
            <KindnessPanel
              score={kindnessScore}
              notes={kindnessScoreNotes}
              verified={scoreVerified}
            />
          </div>

          <p class="stock" data-out={!inStock}>
            {inStock ? 'Available to order' : 'Currently unavailable'}
          </p>

          {
            variants.length > 1 && variantType && (
              <div class="amazon-variants">
                <p class="amazon-variants__label">
                  {variantType}: <strong>{variantValue}</strong>
                </p>
                <div class="amazon-variants__list" role="list">
                  {variants.map((v) => (
                    <a
                      role="listitem"
                      class:list={[
                        'amazon-variants__item',
                        v.id === product.id && 'is-selected',
                      ]}
                      href={withBase(`products/${v.id}/`)}
                      title={v.data.variantValue || v.data.title}
                    >
                      <picture>
                        <source srcset={productImageSources(v.data.image).webp} type="image/webp" />
                        <img
                          src={withBase(v.data.image)}
                          alt={v.data.variantValue || v.data.title}
                          width="64"
                          height="64"
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                      <span>{v.data.variantValue}</span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          {
            shownBullets.length > 0 && (
              <div class="amazon-bullets">
                <h2>About this item</h2>
                <ul>
                  {shownBullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            ecoTags.length > 0 && (
              <div class="tag-row">
                {ecoTags.map((tag) => (
                  <span class="tag">{ecoTagLabel(tag)}</span>
                ))}
              </div>
            )
          }

          <div class="amazon-pdp__actions">
            <a class="btn btn--primary" href={quoteHref}>Request a quote</a>
            <a class="btn btn--secondary" href={sampleHref}>Request a sample</a>
            <a class="btn btn--ghost" href={withBase("products/")}>Back to products</a>
          </div>
        </div>
      </div>

      {
        specs.length > 0 && (
          <section class="amazon-specs reveal">
            <h2>Product details</h2>
            <table>
              <tbody>
                {specs.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>{row.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )
      }

      <section class="amazon-description prose reveal">
        <h2>Product description</h2>
        <p>{shownDescription}</p>
        {productFamily && <p class="amazon-description__family">Family: {productFamily}</p>}
      </section>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--tint reveal">
        <div class="container">
          <div class="section__head">
            <span class="section__eyebrow">Related</span>
            <h2>Related in this category</h2>
          </div>
          <div class="product-grid">
            {related.map((item, i) => (
              <ProductCard product={item!} style={`animation-delay: ${i * 80}ms`} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const gallery = document.querySelector('[data-gallery]');
  if (gallery) {
    const main = gallery.querySelector('#gallery-main');
    const mainWebp = gallery.querySelector('#gallery-main-webp');
    const thumbs = gallery.querySelectorAll('[data-gallery-src]');
    thumbs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-gallery-src');
        const webp = btn.getAttribute('data-gallery-webp');
        if (!src || !main) return;
        main.setAttribute('src', src);
        if (mainWebp && webp) mainWebp.setAttribute('srcset', webp);
        thumbs.forEach((t) => t.classList.toggle('is-active', t === btn));
      });
    });
  }
</script>
