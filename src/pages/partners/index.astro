---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';
import '../../styles/global.css';

const downloads = [
  {
    title: 'Product template (CSV)',
    file: 'docs/partner-product-template.csv',
    type: 'Required',
    blurb:
      'Nine mandatory columns only — SKU, title, brand, category, description, materials, image, public claims, contact email. One row per SKU.',
    primary: true,
  },
  {
    title: 'Supplier fill guide (PDF)',
    file: 'docs/SUPPLIER-FILL-GUIDE.pdf',
    type: 'Guideline',
    blurb: 'Short printable guide — how to fill each column and what to email us.',
    primary: true,
  },
  {
    title: 'Supplier fill guide (Markdown)',
    file: 'docs/SUPPLIER-FILL-GUIDE.md',
    type: 'Guideline',
    blurb: 'Same guide in Markdown.',
    primary: false,
  },
  {
    title: 'Kindness Score standard',
    file: 'docs/KINDNESS-SCORE-STANDARD.md',
    type: 'Reference',
    blurb: 'How KindNesta scores products after listing — for reference, not part of the submission sheet.',
    primary: false,
  },
];

const requirements = [
  {
    title: 'Nine mandatory fields',
    body: 'SKU, title, brand, category, description, materials, image filename, public claims, and contact email — that is the full template.',
  },
  {
    title: 'Specific claims only',
    body: 'No generic “eco-friendly” fluff. Write the exact wording we may publish, or put none.',
  },
  {
    title: 'Photos with the email',
    body: 'Attach the main product photo named as in the image column. Extra certs are welcome but not required on day one.',
  },
  {
    title: 'We ask for more later',
    body: 'KindNesta follows up only for evidence needed to list and score — suppliers do not fill a long scoring sheet upfront.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Download the template',
    body: 'Get the CSV and fill guide. Open the CSV in Google Sheets or Excel.',
  },
  {
    n: '2',
    title: 'Fill one row per SKU',
    body: 'Complete all nine columns. Keep the header row unchanged.',
  },
  {
    n: '3',
    title: 'Attach photos',
    body: 'Main photo filename must match the image column. Add any certificates you already have.',
  },
  {
    n: '4',
    title: 'Send to KindNesta',
    body: 'Email the CSV + files to kindnesta@proton.me. We acknowledge within 2 business days.',
  },
];
---

<BaseLayout
  title="Partners & suppliers — KindNesta"
  description="Collaborate with KindNesta’s B2B marketplace: download the product template, fill guide, and Kindness Score checklist."
>
  <section class="page-hero reveal">
    <div class="container">
      <span class="section__eyebrow">Partners</span>
      <h1>Supplier &amp; partner hub</h1>
      <p>
        Collaborate with KindNesta’s B2B marketplace — data requirements, EU claim rules, and
        downloadable sheets you can share with your team.
      </p>
      <p style="margin-top: 1.25rem;">
        <a class="btn btn--primary" href="#downloads">Download templates</a>
        <a class="btn btn--ghost" href={withBase('contact/?interest=supplier')} style="margin-left: 0.5rem;">
          Discuss a collaboration
        </a>
      </p>
    </div>
  </section>

  <section class="section reveal" style="padding-top: 0.5rem;">
    <div class="container">
      <div class="partner-intro">
        <div>
          <h2>Who this is for</h2>
          <p>
            Manufacturers and brand suppliers who want transparent B2B listing with a Kindness Score
            retail and enterprise buyers can trust. Reach out if you’d like to explore a
            collaboration.
          </p>
        </div>
        <div>
          <h2>What KindNesta publishes</h2>
          <p>
            Product pages show description, materials, and Kindness Score — not your trade prices or
            MOQ. Trade fields in the template stay for our review only.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint reveal" id="downloads">
    <div class="container">
      <span class="section__eyebrow">Downloads</span>
      <h2 class="section__title">Partner pack</h2>
      <p class="section__lead">
        One short CSV — nine mandatory columns. Open in Sheets or Excel; keep the header row.
      </p>

      <div class="download-grid">
        {
          downloads.map((d) => (
            <article class:list={['download-card', d.primary && 'download-card--primary']}>
              <span class="download-card__type">{d.type}</span>
              <h3>{d.title}</h3>
              <p>{d.blurb}</p>
              <a
                class:list={['btn', d.primary ? 'btn--primary' : 'btn--secondary', 'btn--sm']}
                href={withBase(d.file)}
                download
              >
                Download
              </a>
            </article>
          ))
        }
      </div>

      <p class="download-hint">
        Quick start: open the <strong>product template</strong>, read the <strong>fill guide</strong>,
        replace example rows, attach PDFs named in <code>evidencePackFileNames</code>, then email{' '}
        <a href="mailto:kindnesta@proton.me">kindnesta@proton.me</a>.
      </p>
    </div>
  </section>

  <section class="section reveal" id="process">
    <div class="container">
      <span class="section__eyebrow">Process</span>
      <h2 class="section__title">How to submit products</h2>
      <ol class="process-steps">
        {
          steps.map((s) => (
            <li>
              <span class="process-steps__n" aria-hidden="true">
                {s.n}
              </span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tint reveal" id="requirements">
    <div class="container">
      <span class="section__eyebrow">Requirements</span>
      <h2 class="section__title">What we need from suppliers</h2>
      <p class="section__lead">
        Certificates are not required just to be listed — but they <strong>are</strong> required if
        you want recycled / organic / FSC-style claims or a Strong Kindness Score.
      </p>
      <div class="req-grid">
        {
          requirements.map((r) => (
            <article class="req-card">
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section reveal" id="claims">
    <div class="container prose-page">
      <h2>EU claim rules (read before writing copy)</h2>
      <p>
        Under EmpCo (from 27 Sep 2026 in the EU), generic words like <em>eco-friendly</em>,
        <em>green</em>, <em>sustainable</em>, or <em>climate neutral</em> face strict limits without
        excellent, verified performance. Prefer specific claims with % and scheme names.
      </p>
      <ul>
        <li>
          <strong>Good:</strong> Made from 100% GRS-certified recycled cotton paper
        </li>
        <li>
          <strong>Bad:</strong> Eco-friendly hangtag
        </li>
      </ul>
      <p>Typical proof by claim type:</p>
      <ul>
        <li>Recycled content → <strong>GRS</strong> or <strong>RCS</strong></li>
        <li>Organic cotton → <strong>GOTS</strong></li>
        <li>Responsible paper / forest fibre → <strong>FSC</strong> or <strong>PEFC</strong></li>
        <li>Harmful-substance testing (textiles) → <strong>OEKO-TEX Standard 100</strong></li>
        <li>Broad excellent performance → <strong>EU Ecolabel</strong> / Blue Angel</li>
      </ul>
      <p>
        Full scoring detail:
        <a href={withBase('kindness-score/')}>Kindness Score for buyers</a>
        ·
        <a href={withBase('docs/KINDNESS-SCORE-STANDARD.md')}>scoring standard download</a>
      </p>
    </div>
  </section>

  <section class="section section--tint reveal" id="categories">
    <div class="container">
      <span class="section__eyebrow">Marketplace</span>
      <h2 class="section__title">Categories live today</h2>
      <p style="max-width: 40rem; color: var(--md-sys-color-on-surface-variant);">
        These aisles are open in the catalogue now. Use free-text categories in the template — if you
        are outside this list, we will map or open a new aisle.
      </p>
      <div class="blog-regions" style="margin-top: 1rem;">
        {
          ['hangtags', 'hangers', 'packaging', 'bags', 'polybags', 'stationery', 'labels', 'trims'].map(
            (c) => (
              <a class="tag" href={withBase(`products/?category=${c}`)}>
                {c}
              </a>
            )
          )
        }
      </div>
      <p style="margin-top: 1.5rem; max-width: 40rem; color: var(--md-sys-color-on-surface-variant);">
        After you email <a href="mailto:kindnesta@proton.me">kindnesta@proton.me</a>, we acknowledge
        within <strong>2 business days</strong> and follow up only for evidence needed to list and
        score.
      </p>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <div class="section__head" style="max-width: 36rem; margin-inline: 0;">
        <h2>Ready to collaborate?</h2>
        <p>
          Download the pack, complete your first SKUs, and send the sheet plus evidence — or email us
          to discuss a partnership before you fill the template.
        </p>
      </div>
      <div class="page-actions">
        <a class="btn btn--primary" href="mailto:kindnesta@proton.me?subject=Supplier%20inquiry">
          Email kindnesta@proton.me
        </a>
        <a class="btn btn--ghost" href={withBase('contact/?interest=supplier')}>Contact form</a>
        <a class="btn btn--ghost" href="#downloads">Back to downloads</a>
      </div>
    </div>
  </section>
</BaseLayout>
