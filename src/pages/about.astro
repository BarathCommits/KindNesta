---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import '../styles/global.css';
---

<BaseLayout
  title="About — KindNesta"
  description="KindNesta sources and sells eco-friendly products for retail outlets and enterprise buyers — with Kindness Scores on every product."
>
  <section class="page-hero reveal">
    <div class="container">
      <span class="section__eyebrow">About</span>
      <h1>We source and sell kinder products</h1>
      <p>
        KindNesta is a startup that sources and sells eco-friendly products — so buyers can compare
        impact, pack economics, and assortment fit, then purchase with confidence.
      </p>
    </div>
  </section>

  <section class="section reveal" style="padding-top: 1rem;">
    <div class="container">
      <div class="partner-grid">
        <article class="partner-panel partner-panel--retail" id="retail">
          <h2>For retail outlets</h2>
          <p>
            Specialty grocery, gift, zero-waste, and lifestyle retailers buy from KindNesta to fill
            shelves with products that have a clear Kindness Score and a merchandisable story.
          </p>
          <ul>
            <li>Case-ready formats across kitchen, home, care, garden, and dress</li>
            <li>Pack size, MOQ, and suggested retail on every product</li>
            <li>Score notes for shelf talkers and staff training</li>
            <li>Sales support for pricing, lead times, and samples</li>
          </ul>
        </article>

        <article class="partner-panel partner-panel--enterprise" id="enterprise">
          <h2>For enterprise buyers</h2>
          <p>
            Facilities, hospitality, and people-ops teams buy kinder essentials for workplaces,
            amenities, and employee programs — with scoring that supports vendor questionnaires.
          </p>
          <ul>
            <li>Volume-friendly personal care and home care formats</li>
            <li>Transparent inputs: materials, packaging, sourcing</li>
            <li>Support for RFPs and multi-site programs</li>
            <li>Sample requests before line review or rollout</li>
          </ul>
        </article>
      </div>

      <div class="prose" id="kindness-score">
        <h2>How Kindness Score works</h2>
        <p>
          Every product we sell carries a <strong>Kindness Score from 0 to 100</strong>. Higher means
          a stronger profile for people and planet. Scores are set by the KindNesta team based on:
        </p>
        <ul>
          <li>Materials and ingredients</li>
          <li>Packaging and refill options</li>
          <li>Sourcing and logistics signals we can verify</li>
        </ul>
        <p>
          Scores are not a third-party life-cycle assessment. They are a transparent rating so you
          can compare products quickly. Product pages include the notes behind each number.
        </p>
      </div>

      <p style="margin-top: 2.25rem;">
        <a class="btn btn--primary" href={withBase("contact/")}>Contact sales</a>
        <a class="btn btn--ghost" href={withBase("products/")} style="margin-left: 0.5rem;">Browse products</a>
      </p>
    </div>
  </section>
</BaseLayout>
