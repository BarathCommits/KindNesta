---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import '../styles/global.css';
---

<BaseLayout
  title="About — KindNesta"
  description="KindNesta offers eco-friendly packaging and apparel trims — with Kindness Scores on every product."
>
  <section class="page-hero reveal">
    <div class="container">
      <span class="section__eyebrow">About</span>
      <h1>Kinder products, clearly scored</h1>
      <p>
        KindNesta helps buyers discover eco-friendly packaging and apparel trims — and compare
        impact with a Kindness Score on every product.
      </p>
    </div>
  </section>

  <section class="section reveal" style="padding-top: 1rem;">
    <div class="container">
      <div class="partner-grid">
        <article class="partner-panel partner-panel--retail" id="retail">
          <h2>For retail outlets</h2>
          <p>
            Specialty grocery, gift, zero-waste, and lifestyle retailers use KindNesta to find
            products with a clear Kindness Score and a merchandisable story.
          </p>
          <ul>
            <li>Assortment across hangtags, packaging, bags, labels, and trims</li>
            <li>Score notes for shelf talkers and staff training</li>
            <li>Impact messaging customers can understand at a glance</li>
          </ul>
        </article>

        <article class="partner-panel partner-panel--enterprise" id="enterprise">
          <h2>For enterprise buyers</h2>
          <p>
            Facilities, hospitality, and people-ops teams explore kinder essentials for workplaces
            and programs — with scoring that supports sustainability conversations.
          </p>
          <ul>
            <li>Transparent inputs: materials, packaging, certifications</li>
            <li>Score notes for vendor questionnaires</li>
            <li>Support for multi-site and program planning</li>
          </ul>
        </article>
      </div>

      <div class="prose" id="kindness-score">
        <h2>How Kindness Score works</h2>
        <p>
          Every product carries a <strong>Kindness Score from 0 to 100</strong>. Higher means a
          stronger evidence profile for people and planet. Scores follow KindNesta’s
          <strong>EU-aligned checklist</strong> (chemical safety, material %, third-party
          certifications, circularity, packaging, and traceability) — informed by EmpCo green-claim
          rules, PPWR packaging expectations, REACH, and ESPR / Digital Product Passport readiness.
        </p>
        <ul>
          <li>Gate checks stop weak or illegal-style green claims</li>
          <li>Pillar checks award points only when evidence is on file</li>
          <li>Recognised third-party certifications score higher than unverified claims</li>
        </ul>
        <p>
          Scores are not a third-party life-cycle assessment. They are a transparent rating so you
          can compare products quickly.
          <a href={withBase("kindness-score/")}>Read the full Kindness Score guide →</a>
        </p>
      </div>

      <p style="margin-top: 2.25rem;">
        <a class="btn btn--primary" href={withBase("contact/")}>Get in touch</a>
        <a class="btn btn--ghost" href={withBase("kindness-score/")} style="margin-left: 0.5rem;">Kindness Score</a>
        <a class="btn btn--ghost" href={withBase("products/")} style="margin-left: 0.5rem;">Browse products</a>
      </p>
    </div>
  </section>
</BaseLayout>
