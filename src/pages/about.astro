---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import '../styles/global.css';
---

<BaseLayout
  title="About — KindNesta"
  description="KindNesta — the kinder way to buy. A sustainability e-commerce destination with Kindness Scores on every product."
>
  <section class="page-hero reveal">
    <div class="container">
      <span class="section__eyebrow">About</span>
      <h1>The kinder way to buy.</h1>
      <p>
        KindNesta is a sustainability e-commerce destination — helping buyers discover kinder
        products and compare impact with a Kindness Score on every listing.
      </p>
    </div>
  </section>

  <section class="section reveal" style="padding-top: 1.5rem;">
    <div class="container">
      <div class="about-layout">
        <div class="about-block">
          <h2>Who scores the products?</h2>
          <p>
            KindNesta reviews supplier submissions against our EU-aligned checklist (gates A1–A7 and
            evidence pillars). The Kindness Score is our <strong>internal comparison rating</strong>
            — not a third-party ecolabel, PEF study, or official EU mark. Until certificates and
            material evidence are verified, scores are marked <strong>provisional</strong>.
          </p>
        </div>

        <div class="about-block">
          <h2>How to reach us</h2>
          <ul class="about-list">
            <li>
              Email:
              <a href="mailto:kindnesta@proton.me">kindnesta@proton.me</a>
            </li>
            <li>Typical response: 1–2 business days</li>
            <li>
              Suppliers: use the
              <a href={withBase('partners/')}>partner hub</a>
              template pack
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint reveal">
    <div class="container">
      <div class="section__head">
        <span class="section__eyebrow">Who we serve</span>
        <h2>Built for buyers who stock and scale</h2>
        <p>One KindNesta marketplace — for retail programmes and enterprise procurement.</p>
      </div>

      <div class="partner-grid">
        <article class="partner-panel partner-panel--retail" id="retail">
          <h2>For retail outlets</h2>
          <p>
            Grocery, gift, zero-waste, and lifestyle retailers use KindNesta to find products with a
            clear Kindness Score and a merchandisable story.
          </p>
          <ul>
            <li>Growing marketplace assortment across categories</li>
            <li>Score notes for staff training and buyer decks</li>
            <li>Specific claim language buyers can stand behind</li>
          </ul>
        </article>

        <article class="partner-panel partner-panel--enterprise" id="enterprise">
          <h2>For enterprise buyers</h2>
          <p>
            Brand, facilities, and procurement teams use KindNesta for programmes that need
            transparent scoring for questionnaires and supplier reviews.
          </p>
          <ul>
            <li>Transparent inputs: materials, packaging, certifications</li>
            <li>Score notes for vendor questionnaires</li>
            <li>Support for multi-site and program planning</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section reveal" id="kindness-score">
    <div class="container">
      <div class="about-layout">
        <div class="about-block">
          <h2>How Kindness Score works</h2>
          <p>
            Every product carries a <strong>Kindness Score from 0 to 100</strong>. Higher means a
            stronger evidence profile. Scores follow KindNesta’s EU-aligned checklist — informed by
            EmpCo green-claim rules, PPWR packaging expectations, REACH, and ESPR / Digital Product
            Passport readiness.
          </p>
          <p>
            <a href={withBase('kindness-score/')}>Read the full Kindness Score guide →</a>
          </p>
        </div>
      </div>

      <div class="page-actions">
        <a class="btn btn--primary" href={withBase('contact/')}>Get in touch</a>
        <a class="btn btn--secondary" href={withBase('kindness-score/')}>Kindness Score</a>
        <a class="btn btn--ghost" href={withBase('products/')}>Browse products</a>
      </div>
    </div>
  </section>
</BaseLayout>
