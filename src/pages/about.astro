---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import '../styles/global.css';
---

<BaseLayout
  title="About — KindNesta"
  description="KindNesta — the kinder way to buy. Who we serve, how we score, and how to reach us."
>
  <section class="page-hero reveal">
    <div class="container">
      <span class="section__eyebrow">About</span>
      <h1>The kinder way to buy.</h1>
      <p>
        KindNesta helps buyers discover scored packaging and apparel trims — and compare impact with
        a Kindness Score on every listing.
      </p>
    </div>
  </section>

  <section class="section reveal" style="padding-top: 1rem;">
    <div class="container prose-page">
      <h2>Who scores the products?</h2>
      <p>
        KindNesta reviews supplier submissions against our EU-aligned checklist (gates A1–A7 and
        evidence pillars). The Kindness Score is our <strong>internal comparison rating</strong> —
        not a third-party ecolabel, PEF study, or official EU mark. Until certificates and material
        evidence are verified, scores are marked <strong>provisional</strong>.
      </p>
      <h2>How to reach us</h2>
      <ul>
        <li>Email: <a href="mailto:kindnesta@proton.me">kindnesta@proton.me</a></li>
        <li>Typical response: 1–2 business days</li>
        <li>Suppliers: use the <a href={withBase('partners/')}>partner hub</a> template pack</li>
      </ul>
    </div>
  </section>

  <section class="section section--tint reveal" style="padding-top: 1rem;">
    <div class="container">
      <div class="partner-grid">
        <article class="partner-panel partner-panel--retail" id="retail">
          <h2>For retail outlets</h2>
          <p>
            Apparel, gift, and specialty retailers use KindNesta to find packaging and trims with a
            clear Kindness Score and a merchandisable story.
          </p>
          <ul>
            <li>Assortment across hangtags, packaging, bags, labels, and trims</li>
            <li>Score notes for staff training and buyer decks</li>
            <li>Specific claim language buyers can stand behind</li>
          </ul>
        </article>

        <article class="partner-panel partner-panel--enterprise" id="enterprise">
          <h2>For enterprise buyers</h2>
          <p>
            Brand and procurement teams use KindNesta for packaging and trim programmes that need
            transparent scoring for questionnaires and supplier reviews.
          </p>
          <ul>
            <li>Transparent inputs: materials, packaging, certifications</li>
            <li>Score notes for vendor questionnaires</li>
            <li>Support for multi-site and program planning</li>
          </ul>
        </article>
      </div>

      <div class="prose" id="kindness-score" style="margin-top: 2rem;">
        <h2>How Kindness Score works</h2>
        <p>
          Every product carries a <strong>Kindness Score from 0 to 100</strong>. Higher means a
          stronger evidence profile. Scores follow KindNesta’s EU-aligned checklist — informed by
          EmpCo green-claim rules, PPWR packaging expectations, REACH, and ESPR / Digital Product
          Passport readiness.
        </p>
        <p>
          <a href={withBase("kindness-score/")}>Read the full Kindness Score guide →</a>
        </p>
      </div>

      <p style="margin-top: 2.25rem;">
        <a class="btn btn--primary" href={withBase("contact/?interest=quote")}>Request a quote</a>
        <a class="btn btn--ghost" href={withBase("kindness-score/")} style="margin-left: 0.5rem;">Kindness Score</a>
        <a class="btn btn--ghost" href={withBase("products/")} style="margin-left: 0.5rem;">Browse products</a>
      </p>
    </div>
  </section>
</BaseLayout>
