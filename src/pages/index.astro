---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { categoryLabel } from '../lib/products';
import { withBase } from '../lib/urls';
import '../styles/global.css';

const products = await getCollection('products');
const featured = products
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.kindnessScore - a.data.kindnessScore)
  .slice(0, 3);

const categories = [
  { id: 'hangtags', blurb: 'GRS and FSC hangtags from recycled cotton paper and kraft.' },
  { id: 'hangers', blurb: 'Paper hangers — cotton recycled and FSC certified board.' },
  { id: 'packaging', blurb: 'Boxes, envelopes, tissue, and case-making packaging.' },
  { id: 'bags', blurb: 'Shopping bags in cotton recycled board and FSC paper.' },
  { id: 'labels', blurb: 'Organic cotton, GOTS, GRS, and Oeko-Tex apparel labels.' },
  { id: 'trims', blurb: 'Hangtag strings, tapes, ropes, and recycled elastics.' },
] as const;
---

<BaseLayout
  title="KindNesta — Sustainable packaging & trims"
  description="KindNesta offers eco packaging, hangtags, labels, and trims for apparel and retail buyers — with Kindness Scores on every product."
  transparentHeader
>
  <section class="hero" style={`--hero-image: url('${withBase("images/hero-botanical.svg")}')`}>
    <div class="hero__media" aria-hidden="true"></div>
    <img
      class="hero__logo-blend"
      src={withBase("images/kindnesta-logo.png")}
      alt=""
      width="320"
      height="320"
      decoding="async"
      aria-hidden="true"
    />
    <div class="hero__shell">
      <div class="hero__content">
        <p class="hero__eyebrow">Eco products · Kindness Score</p>
        <h1 class="hero__brand">
          <span class="hero__brand-primary">Kind</span><span class="hero__brand-secondary">Nesta</span>
        </h1>
        <p class="hero__lead">
          Certified eco packaging and apparel trims — hangtags, hangers, bags, labels, and more —
          with a Kindness Score on every product.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={withBase("products/")}>Browse products</a>
          <a class="btn btn--secondary" href={withBase("contact/")}>Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip reveal" aria-label="What KindNesta offers">
    <div class="container trust-strip__inner">
      <p><strong>Certified materials</strong> — GRS, FSC, GOTS, and more</p>
      <p><strong>Clear assortment</strong> — packaging, labels, and trims</p>
      <p><strong>Kindness Score</strong> — compare impact before you choose</p>
    </div>
  </section>

  <section class="section reveal" id="buyers">
    <div class="container">
      <div class="section__head">
        <span class="section__eyebrow">Who we serve</span>
        <h2>Built for buyers who stock and scale</h2>
        <p>The same KindNesta assortment, two ways to buy.</p>
      </div>
      <div class="audience-grid">
        <article class="audience-card">
          <span class="audience-card__label">Retail outlets</span>
          <h3>Grocery, gift, and specialty retail</h3>
          <p>
            Shelf-ready eco products with clear impact stories, case packs, and Kindness Scores your
            customers can understand at a glance.
          </p>
          <ul class="audience-card__list">
            <li>Clear Kindness Scores on every product</li>
            <li>Impact notes for shelf talkers and staff</li>
            <li>Assortment support for greener shelves</li>
          </ul>
          <a class="btn btn--ghost" href={withBase("partners/")}>Partner &amp; supplier hub</a>
        </article>
        <article class="audience-card audience-card--enterprise">
          <span class="audience-card__label audience-card__label--green">Enterprise</span>
          <h3>Procurement, facilities &amp; amenities</h3>
          <p>
            Lower-impact essentials for workplaces, hospitality, and employee programs — with
            transparent scoring for sustainability reporting.
          </p>
          <ul class="audience-card__list">
            <li>Program-ready packaging, labels &amp; trims</li>
            <li>Score notes for vendor questionnaires</li>
            <li>Volume ordering support</li>
          </ul>
          <a class="btn btn--ghost" href={withBase("about/#enterprise")}>Enterprise details</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tint reveal" id="categories">
    <div class="container">
      <div class="section__head">
        <span class="section__eyebrow section__eyebrow--green">Products</span>
        <h2>Browse by category</h2>
        <p>Start with the aisle or program you need to fill.</p>
      </div>
      <ul class="category-list">
        {
          categories.map((cat, i) => (
            <li>
              <a class="category-link" href={withBase(`products/?category=${cat.id}`)}>
                <span class="category-link__index">{String(i + 1).padStart(2, '0')}</span>
                <span class="category-link__name">{categoryLabel(cat.id)}</span>
                <span class="category-link__blurb">{cat.blurb}</span>
                <span class="category-link__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section reveal" id="featured">
    <div class="container">
      <div class="section__head">
        <span class="section__eyebrow">Featured</span>
        <h2>High-scoring picks</h2>
        <p>Strong Kindness Scores from our current assortment.</p>
      </div>
      <div class="product-grid">
        {
          featured.map((product, i) => (
            <ProductCard product={product} style={`animation-delay: ${i * 100}ms`} />
          ))
        }
      </div>
      <p class="section__cta">
        <a class="btn btn--ghost" href={withBase("products/")}>View all products</a>
      </p>
    </div>
  </section>

  <section class="section section--tint reveal" id="kindness-score">
    <div class="container split">
      <div class="section__head" style="margin-bottom: 0;">
        <span class="section__eyebrow">Transparency</span>
        <h2>Kindness Score on every product</h2>
      </div>
      <div>
        <p class="split__copy">
          Every product is rated <strong>0–100</strong> on materials, packaging, and certifications.
          Use it to compare options — with notes on each product page.
        </p>
        <div class="score-bands">
          <span data-band="high">80–100 Strong</span>
          <span data-band="mid">50–79 Good</span>
          <span data-band="low">0–49 Fair</span>
        </div>
        <p style="margin-top: 1.75rem;">
          <a class="btn btn--ghost" href={withBase("kindness-score/")}>How we score</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section reveal" id="process">
    <div class="container">
      <div class="section__head">
        <span class="section__eyebrow">How it works</span>
        <h2>From discovery to delivery</h2>
        <p>A simple path to buy kinder products from KindNesta.</p>
      </div>
      <ol class="process-list">
        <li>
          <h3>Browse products</h3>
          <p>Filter by category and Kindness Score. Read the description and score notes.</p>
        </li>
        <li>
          <h3>Compare impact</h3>
          <p>Use Kindness Scores to shortlist kinder options for your assortment.</p>
        </li>
        <li>
          <h3>Get in touch</h3>
          <p>Tell us what you need — our team can help with next steps.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--cta reveal" id="get-in-touch">
    <div class="container">
      <div class="cta-block">
        <img
          class="cta-block__logo-blend"
          src={withBase("images/kindnesta-logo.png")}
          alt=""
          width="220"
          height="220"
          decoding="async"
          aria-hidden="true"
        />
        <h2>Ready to choose kinder products?</h2>
        <p>Retail and enterprise buyers — tell us what you’re looking for.</p>
        <div class="hero__actions" style="margin-top: 1.5rem;">
          <a class="btn btn--primary" href={withBase("contact/")}>Get in touch</a>
          <a class="btn btn--secondary" href={withBase("products/")}>Browse products</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
