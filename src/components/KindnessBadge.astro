---
import { kindnessBand, kindnessBandLabel } from '../lib/products';

interface Props {
  score: number;
  compact?: boolean;
  verified?: boolean;
}

const { score, compact = false, verified = false } = Astro.props;
const band = kindnessBand(score);
const label = kindnessBandLabel(score);
const status = verified ? 'Verified' : 'Provisional';
---

<span
  class:list={['kindness-badge', compact && 'kindness-badge--compact', !verified && 'kindness-badge--provisional']}
  data-band={band}
  title={`Kindness Score ${score} · ${label} · ${status} (KindNesta internal rating)`}
>
  <span class="kindness-badge__ring" style={`--pct: ${score}`} aria-hidden="true">
    <span>{score}</span>
  </span>
  <span class="kindness-badge__text">
    {compact ? `${label}` : `Kindness Score · ${label}`}
    {
      !verified && (
        <span class="kindness-badge__status">{compact ? ' · Prov.' : ' · Provisional'}</span>
      )
    }
  </span>
</span>
