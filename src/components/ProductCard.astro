---
import type { CollectionEntry } from 'astro:content';
import KindnessBadge from './KindnessBadge.astro';
import { categoryLabel } from '../lib/products';
import { withBase } from '../lib/urls';

interface Props {
  product: CollectionEntry<'products'>;
  style?: string;
}

const { product, style } = Astro.props;
const { title, shortDescription, category, subcategory, brand, image, kindnessScore, bulletPoints, scoreVerified } =
  product.data;
const href = withBase(`products/${product.id}/`);
const imageSrc = withBase(image);
const previewBullets = bulletPoints.slice(0, 2);
---

<article class="product-card" style={style}>
  <a class="product-card__link" href={href}>
    <div class="product-card__media">
      <img src={imageSrc} alt={title} loading="lazy" width="640" height="800" />
    </div>
    <div class="product-card__body">
      <div class="product-card__meta">
        <span class="product-card__category">{subcategory || categoryLabel(category)}</span>
        <KindnessBadge score={kindnessScore} compact verified={scoreVerified} />
      </div>
      <p class="product-card__brand">{brand}</p>
      <h3>{title}</h3>
      <p>{shortDescription}</p>
      {
        previewBullets.length > 0 && (
          <ul class="product-card__bullets">
            {previewBullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        )
      }
      <div class="product-card__footer">
        <span class="product-card__cue">View listing</span>
      </div>
    </div>
  </a>
</article>
