---
import { withBase } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
  ogImage?: string;
}

const {
  title,
  description = 'KindNesta — the kinder way to buy. Scored packaging and apparel trims with a Kindness Score on every listing.',
  transparentHeader = false,
  ogImage = 'images/kindnesta-logo.png',
} = Astro.props;
const pathname = Astro.url.pathname;
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(withBase(ogImage).replace(/^\//, ''), Astro.site).href;
const nav = [
  { href: withBase('products/'), label: 'Products' },
  { href: withBase('kindness-score/'), label: 'Score' },
  { href: withBase('partners/'), label: 'Partners' },
  { href: withBase('blog/'), label: 'Journal' },
  { href: withBase('about/'), label: 'About' },
];

function normalize(path: string) {
  return path.replace(/\/+$/, '') || '';
}

function isCurrent(href: string) {
  const current = normalize(pathname);
  const target = normalize(href);
  const home = normalize(base);
  if (target === home) return current === home || current === '';
  return current === target || current.startsWith(`${target}/`);
}
---

<!doctype html>
<html lang="en" style={`--asset-base: ${base}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f6b45" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" href={withBase('images/kindnesta-logo.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class:list={['site-header', transparentHeader && 'site-header--transparent']} id="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={withBase()}>
          <img class="brand__logo" src={withBase('images/kindnesta-logo.png')} alt="" width="36" height="36" />
          <span class="brand__wordmark"><span class="brand__kind">Kind</span><span class="brand__nesta">Nesta</span></span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-nav"
          id="nav-toggle"
        >
          <span class="visually-hidden">Menu</span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
        <nav class="nav" id="primary-nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a class="btn btn--primary btn--sm nav__cta" href={withBase('contact/')}>
            Contact
          </a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          <div class="site-footer__brand">
            <a class="brand" href={withBase()}>
              <img class="brand__logo" src={withBase('images/kindnesta-logo.png')} alt="" width="36" height="36" />
              <span class="brand__wordmark"><span class="brand__kind">Kind</span><span class="brand__nesta">Nesta</span></span>
            </a>
            <p>
              The kinder way to buy — scored packaging and apparel trims with a Kindness Score on
              every listing.
            </p>
          </div>
          <div class="site-footer__col">
            <h3>Products</h3>
            <ul>
              <li><a href={withBase('products/')}>All products</a></li>
              <li><a href={withBase('products/?category=hangtags')}>Hangtags</a></li>
              <li><a href={withBase('products/?category=hangers')}>Hangers</a></li>
              <li><a href={withBase('products/?category=packaging')}>Packaging</a></li>
              <li><a href={withBase('products/?category=bags')}>Shopping bags</a></li>
              <li><a href={withBase('products/?category=polybags')}>Polybags</a></li>
              <li><a href={withBase('products/?category=labels')}>Labels</a></li>
              <li><a href={withBase('products/?category=stationery')}>Stationery</a></li>
              <li><a href={withBase('products/?category=trims')}>Trims &amp; tapes</a></li>
            </ul>
          </div>
          <div class="site-footer__col">
            <h3>Company</h3>
            <ul>
              <li><a href={withBase('about/')}>About</a></li>
              <li><a href={withBase('kindness-score/')}>Kindness Score</a></li>
              <li><a href={withBase('partners/')}>Partners &amp; suppliers</a></li>
              <li><a href={withBase('blog/')}>Impact journal</a></li>
              <li><a href={withBase('contact/')}>Contact</a></li>
              <li><a href="mailto:kindnesta@proton.me">kindnesta@proton.me</a></li>
            </ul>
          </div>
        </div>
        <div class="site-footer__bottom">
          <span>© {year} KindNesta</span>
          <a href="mailto:kindnesta@proton.me">kindnesta@proton.me</a>
          <span>The kinder way to buy.</span>
        </div>
      </div>
    </footer>
    <script>
      const header = document.getElementById('site-header');
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('primary-nav');

      const onScroll = () => {
        if (!header) return;
        header.classList.toggle('is-scrolled', window.scrollY > 12);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      toggle?.addEventListener('click', () => {
        const open = header?.classList.toggle('is-nav-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      nav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          header?.classList.remove('is-nav-open');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });

      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
